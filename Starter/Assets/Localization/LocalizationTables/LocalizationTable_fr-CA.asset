      m_Items:
      - rid: 3461314759755304037
  - m_Id: 192599009853956124
    m_Localized: "D\xE9marrage de la cam\xE9ra\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 192599009853956125
    m_Localized: "Patte du haut = boule \xB7 Patte du bas = queue"
    m_Metadata:
      m_Items: []
  - m_Id: 192599009853956126
    m_Localized: Beau coup!
    m_Metadata:
      m_Items: []
  - m_Id: 192599009853956127
    m_Localized: "Tout le monde est pr\xEAt. C\u2019est parti!"
