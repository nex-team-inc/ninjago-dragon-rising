    m_Metadata:
      m_Items: []
  - m_Id: 192599009853956117
    m_Localized: "L\xE8ve la main"
    m_Metadata:
      m_Items: []
  - m_Id: 192599009853956118
    m_Localized: "L\xE8ve une patte bien haut\_: c\u2019est la boule. Ta patte du
      bas, c\u2019est la queue."
    m_Metadata:
      m_Items: []
  - m_Id: 192599009853956119
    m_Localized: Frappe ta patte du haut avec ta patte du bas!
    m_Metadata:
      m_Items: []
  - m_Id: 192599009853956120
    m_Localized: "C\u2019est pr\xEAt!"
    m_Metadata:
      m_Items: []
  - m_Id: 192599009853956121
