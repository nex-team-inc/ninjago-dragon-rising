# Ball_Lucky - green ball with a gold four-leaf clover.
# Ball family structure (see Ball_Basic.paint); green ramp, the clover is the gold decal.
size 32 32
key
  K #103a18  ink (outer line, darkest of the ramp)
  k #1f7a2e  outline on the lit side
  M #34b448  ball base (icons.json color)
  s #1f8a34  shadow / reflected light
  S #135a22  core shadow
  H #dfffe0  highlight
  C #ffe060  clover (lit)
  c #c1901c  clover shade (edge and inside the shadow crescent)
strokes
  ellipse K 16 16 14.8 14.8
seeds
  M 16 16
ops
  band M s 1 1 7
  band M S 1 1 3
  band M s 1 1 1
# a shamrock: two round top lobes, a rounded base and a short stem, worn to c on the shadow side
shade at 12 7
  .CC...Cc.
  CCCC.CCcc
  CCCCCCCcc
  CCCCCCccc
  .CCCCCcc.
  ..CCCcc..
  ...Cc....
  ...Cc....
  ..ccc....
# highlight: one window streak following the top-left rim
shade at 6 5
  ....HH
  ..HHHH
  .HHHH.
  .HH...
ops
  edge K k -1 -1
  px k 2 19 19 2
  px K 3 23 23 3
