  V #c3c8d6  silver line=v
  v #7d839f  silver shade
  A #6e9be4  blue light
  B #4566bb  blue armour line=b
  F #4566bb  shield field (own region key) line=b
  N #2c3a86  boots (own region key) line=b
  b #2c3a86  blue shade
  G #5c360c  gold outline
  Y #ffd65a  gold light, eye glow
  Z #e8a830  gold line=z
  z #a8661a  gold shade
  Q #4a0a16  plume outline
  R #e0485a  plume line=r
  r #9c2236  plume shade
  L #ff8a94  plume light

