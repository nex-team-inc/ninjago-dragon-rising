# Icon_Camera - the camera glyph (Camera panel title, "show both paws" placeholder). Grey body with a viewfinder
# bump, a gold lens ring round dark glass, a red record light. Light from the top-left: lit top face, shadowed
# right side and base, one glint on the glass.
size 16 16
key
  K #151a2a  outline and lens glass
  W #e4e8f0  lit face / glint
  B #a8aec0  body
  b #767e96  body shadow
  g #e8b040  lens ring (gold)
  r #e8504a  record light
